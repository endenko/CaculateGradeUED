# --- UED Calculate Grade environment ---
# Copy to .env or export in your shell.

# OCR engine for handwriting mode: paddle (default) | tesseract | google
OCR_HANDWRITING_ENGINE=paddle

# PaddleOCR model profile: medium (default, PP-OCRv6 ~134 MB) | hybrid (mobile det + medium rec, ~84 MB)
# | mobile (PP-OCRv5 ~10 MB). Use 'hybrid' on memory-constrained hosts (Render free tier = 512 MB).
# OCR_MODEL_SIZE=hybrid

# Paddle inference run mode: paddle (stable, default) | mkldnn (oneDNN, Linux only)
# NOTE: 'mkldnn' crashes with PP-OCRv6 models on Windows/paddle 3.3 — keep 'paddle' for stability.
# PADDLE_RUN_MODE=paddle

# Path to Tesseract binary (leave empty to use PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# SQLite database path
# DB_PATH=grade.db

# Upload folder
# UPLOAD_FOLDER=uploads

# Flask port (python app.py only; gunicorn uses --bind in Dockerfile)
# PORT=5000

# --- Only for the optional Google Vision engine ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
